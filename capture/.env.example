# 复制成 .env 后按自己的环境改：cp .env.example .env

# Home Assistant 地址（容器里看到的地址，不是浏览器地址）
#   HA 跑在 Docker 里、与本容器同一网络  -> http://homeassistant:8123
#   HA 跑在宿主机上                     -> http://host.docker.internal:8123
#   HA 有固定 IP                        -> http://192.168.1.10:8123
HA_URL=http://host.docker.internal:8123

# HA「长期访问令牌」：HA 网页 -> 左下角个人头像 -> 安全 -> 长期访问令牌 -> 创建
# 只用来调 wuhan_gas.set_token 一个服务，不写进镜像、不进 git
HA_TOKEN=

# 只对这些域名的请求动手，逗号分隔。小程序「武汉燃气」的云接口就在 babel-group.cn
CAP_HOSTS=wp.babel-group.cn,babel-group.cn
